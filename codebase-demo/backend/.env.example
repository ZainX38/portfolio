# Optional: used only by the offline snapshot command, never by visitors.
# GITHUB_TOKEN=

DEMO_REPOSITORY=https://github.com/psf/requests
# Optional full SHA: downloader and API both enforce this pin.
# DEMO_REPOSITORY_COMMIT=
# Default is ../data/<owner>--<repo>/<commit-or-default>/bundle.json.
# In production set this to the immutable artifact included in your release.
# DEMO_BUNDLE_PATH=/app/data/bundle.json

# Only needed if frontend and API use different origins. Never use *.
# DEMO_ALLOWED_ORIGINS=https://your-portfolio-domain

# Server-side only. Never proxy Ollama itself to the internet.
OLLAMA_URL=http://localhost:11434
OLLAMA_ANSWER_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_CONTEXT_TOKENS=4096
OLLAMA_TIMEOUT_SECONDS=180

# Set these to approved positive values to enable public AI. Zero disables it.
DEMO_DAILY_LIMIT=0
DEMO_IP_PER_MINUTE=0
DEMO_MAX_CONCURRENT=0
DEMO_MAX_QUESTION_CHARS=0
DEMO_MAX_OUTPUT_TOKENS=0
# Production: mount a persistent writable directory for this small daily counter.
# DEMO_USAGE_PATH=/app/usage/usage.sqlite
